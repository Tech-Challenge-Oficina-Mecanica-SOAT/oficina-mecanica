

-- Migration: Adiciona tabela OSItens e coluna Total em OrdensServico
 
-- 1. Adiciona coluna Total na tabela OrdensServico
ALTER TABLE "OrdensServico"
ADD COLUMN "Total" numeric(18,2) NOT NULL DEFAULT 0;
 
-- 2. Cria tabela OSItens
CREATE TABLE "OSItens" (
    "Id"             uuid         NOT NULL,
    "OrdemServicoId" uuid         NOT NULL,
    "Tipo"           integer      NOT NULL,  -- 1=Servico, 2=Peca, 3=Insumo
    "ReferenciaId"   uuid         NOT NULL,
    "Descricao"      varchar(500) NOT NULL,
    "Quantidade"     integer      NOT NULL,
    "PrecoUnitario"  numeric(18,2) NOT NULL,
    CONSTRAINT "PK_OSItens" PRIMARY KEY ("Id"),
    CONSTRAINT "FK_OSItens_OrdensServico" FOREIGN KEY ("OrdemServicoId")
        REFERENCES "OrdensServico" ("Id") ON DELETE CASCADE
);
 
CREATE INDEX "IX_OSItens_OrdemServicoId" ON "OSItens" ("OrdemServicoId");
 