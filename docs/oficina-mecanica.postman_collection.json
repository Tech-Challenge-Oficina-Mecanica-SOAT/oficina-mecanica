            },
            "url": { "raw": "{{baseUrl}}/api/servicos", "host": ["{{baseUrl}}"], "path": ["api", "servicos"] }
          }
        },
        {
          "name": "Listar Serviços",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
