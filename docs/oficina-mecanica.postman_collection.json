            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": \"{{clienteId}}\",\n  \"placa\": \"ABC1234\",\n  \"marca\": \"Toyota\",\n  \"modelo\": \"Corolla\",\n  \"ano\": 2020\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/veiculos", "host": ["{{baseUrl}}"], "path": ["api", "veiculos"] }
          }
        },
        {
          "name": "Listar Veículos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/veiculos", "host": ["{{baseUrl}}"], "path": ["api", "veiculos"] }
          }
        },
        {
          "name": "Consultar Veículo por ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/veiculos/{{veiculoId}}", "host": ["{{baseUrl}}"], "path": ["api", "veiculos", "{{veiculoId}}"] }
          }
        },
        {
          "name": "Consultar por Placa",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/veiculos/placa/ABC1234", "host": ["{{baseUrl}}"], "path": ["api", "veiculos", "placa", "ABC1234"] }
          }
        },
        {
          "name": "Listar Veículos por Cliente",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/veiculos/cliente/{{clienteId}}", "host": ["{{baseUrl}}"], "path": ["api", "veiculos", "cliente", "{{clienteId}}"] }
          }
        }
      ]
    },
    {
      "name": "Serviços",
      "item": [
        {
          "name": "Criar Serviço",
          "event": [
