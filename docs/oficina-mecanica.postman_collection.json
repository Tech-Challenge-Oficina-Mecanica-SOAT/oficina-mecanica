{
  "info": {
    "_postman_id": "oficina-mecanica-api-v2",
    "name": "Oficina Mecânica API - Fase 2",
    "description": "Collection completa da API da Oficina Mecânica. Fluxo recomendado: 1) Auth/Login → 2) Criar Cliente → 3) Criar Veículo → 4) Abrir OS → 5) Avançar status via endpoints de status.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "clienteId", "value": "", "type": "string" },
    { "key": "veiculoId", "value": "", "type": "string" },
    { "key": "osId", "value": "", "type": "string" },
    { "key": "servicoId", "value": "", "type": "string" },
    { "key": "pecaId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('token', json.token);",
                  "  console.log('Token salvo:', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@oficina.com\",\n  \"senha\": \"Admin@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/Auth/login", "host": ["{{baseUrl}}"], "path": ["Auth", "login"] }
          }
        },
        {
          "name": "Registrar Usuário",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Admin Oficina\",\n  \"email\": \"admin@oficina.com\",\n  \"senha\": \"Admin@123\",\n  \"perfil\": 0\n}"
            },
            "url": { "raw": "{{baseUrl}}/Auth/registrar", "host": ["{{baseUrl}}"], "path": ["Auth", "registrar"] }
          }
        }
      ]
    },
    {
      "name": "Público (sem auth)",
      "item": [
        {
          "name": "Consultar Status da OS",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/Publico/os/{{osId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["Publico", "os", "{{osId}}", "status"]
            }
          }
        },
        {
          "name": "Aprovar Orçamento via E-mail (token)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/ordens-servico/aprovar/:token?aprovado=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "ordens-servico", "aprovar", ":token"],
              "variable": [{ "key": "token", "value": "SEU_TOKEN_AQUI" }],
              "query": [{ "key": "aprovado", "value": "true" }]
            }
          }
        }
      ]
    },
    {
      "name": "Clientes",
      "item": [
        {
          "name": "Criar Cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('clienteId', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"João Silva\",\n  \"documento\": \"12345678901\",\n  \"email\": \"joao@email.com\",\n  \"telefone\": \"11999999999\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/clientes", "host": ["{{baseUrl}}"], "path": ["api", "clientes"] }
          }
        },
        {
          "name": "Listar Clientes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/clientes", "host": ["{{baseUrl}}"], "path": ["api", "clientes"] }
          }
        },
        {
          "name": "Consultar Cliente por ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/clientes/{{clienteId}}", "host": ["{{baseUrl}}"], "path": ["api", "clientes", "{{clienteId}}"] }
          }
        },
        {
          "name": "Consultar Cliente por Documento",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/clientes/documento/12345678901",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clientes", "documento", "12345678901"]
            }
          }
        },
        {
          "name": "Atualizar Cliente",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"João Silva Atualizado\",\n  \"email\": \"joao.novo@email.com\",\n  \"telefone\": \"11988888888\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/clientes/{{clienteId}}", "host": ["{{baseUrl}}"], "path": ["api", "clientes", "{{clienteId}}"] }
          }
        },
        {
          "name": "Desativar Cliente",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/clientes/{{clienteId}}/desativar", "host": ["{{baseUrl}}"], "path": ["api", "clientes", "{{clienteId}}", "desativar"] }
          }
        },
        {
          "name": "Ativar Cliente",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/clientes/{{clienteId}}/ativar", "host": ["{{baseUrl}}"], "path": ["api", "clientes", "{{clienteId}}", "ativar"] }
          }
        },
        {
          "name": "Remover Cliente",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/clientes/{{clienteId}}", "host": ["{{baseUrl}}"], "path": ["api", "clientes", "{{clienteId}}"] }
          }
        }
      ]
    },
    {
      "name": "Veículos",
      "item": [
        {
          "name": "Criar Veículo",
          "event": [
