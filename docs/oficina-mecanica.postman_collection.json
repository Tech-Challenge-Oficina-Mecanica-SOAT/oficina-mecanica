          }
        },
        {
          "name": "Listar Serviços Ativos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/servicos/ativos", "host": ["{{baseUrl}}"], "path": ["api", "servicos", "ativos"] }
          }
        }
      ]
    },
    {
      "name": "Peças",
      "item": [
        {
          "name": "Criar Peça",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('pecaId', json.id);",
