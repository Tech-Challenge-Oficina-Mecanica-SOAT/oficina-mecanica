              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantidade\": 10\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/pecas/{{pecaId}}/estoque", "host": ["{{baseUrl}}"], "path": ["api", "pecas", "{{pecaId}}", "estoque"] }
          }
        },
        {
          "name": "Listar Estoque Baixo",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/pecas/estoque-baixo", "host": ["{{baseUrl}}"], "path": ["api", "pecas", "estoque-baixo"] }
          }
        }
      ]
    },
    {
      "name": "Ordens de Serviço",
      "item": [
        {
          "name": "Abrir OS",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('osId', json.id);",
                  "  console.log('OS criada:', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": \"{{clienteId}}\",\n  \"veiculoId\": \"{{veiculoId}}\",\n  \"descricaoProblema\": \"Carro fazendo barulho ao frear\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/ordens-servico", "host": ["{{baseUrl}}"], "path": ["api", "ordens-servico"] }
          }
        },
        {
          "name": "Listar Todas as OS",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/ordens-servico", "host": ["{{baseUrl}}"], "path": ["api", "ordens-servico"] }
          }
        },
        {
          "name": "Listar OS Ordenadas por Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/ordens-servico/ordenadas", "host": ["{{baseUrl}}"], "path": ["api", "ordens-servico", "ordenadas"] }
          }
        },
        {
          "name": "Consultar OS por ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/ordens-servico/{{osId}}", "host": ["{{baseUrl}}"], "path": ["api", "ordens-servico", "{{osId}}"] }
          }
        },
        {
          "name": "Adicionar Itens à OS",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"tipo\": \"servico\",\n    \"referenciaId\": \"{{servicoId}}\",\n    \"quantidade\": 1\n  },\n  {\n    \"tipo\": \"peca\",\n    \"referenciaId\": \"{{pecaId}}\",\n    \"quantidade\": 2\n  }\n]"
            },
            "url": { "raw": "{{baseUrl}}/api/ordens-servico/{{osId}}/itens", "host": ["{{baseUrl}}"], "path": ["api", "ordens-servico", "{{osId}}", "itens"] }
          }
        },
        {
          "name": "Tempo Médio de Execução",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/ordens-servico/tempo-medio-execucao", "host": ["{{baseUrl}}"], "path": ["api", "ordens-servico", "tempo-medio-execucao"] }
          }
        }
      ]
    },
    {
      "name": "Status da OS (fluxo completo)",
      "item": [
        {
          "name": "1 - Iniciar Diagnóstico",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/ordens-servico/{{osId}}/iniciar-diagnostico", "host": ["{{baseUrl}}"], "path": ["api", "ordens-servico", "{{osId}}", "iniciar-diagnostico"] }
          }
        },
        {
          "name": "2 - Enviar para Aprovação (Forçar Status)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"novoStatus\": 2,\n  \"motivo\": \"Diagnóstico concluído. Orçamento R$ 350,00\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/ordens-servico/{{osId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "ordens-servico", "{{osId}}", "status"] }
          }
        },
        {
          "name": "3a - Aprovar Orçamento (via API)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/ordens-servico/{{osId}}/aprovar", "host": ["{{baseUrl}}"], "path": ["api", "ordens-servico", "{{osId}}", "aprovar"] }
          }
        },
        {
          "name": "3b - Rejeitar Orçamento (via API)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motivo\": \"Valor acima do esperado\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/ordens-servico/{{osId}}/rejeitar", "host": ["{{baseUrl}}"], "path": ["api", "ordens-servico", "{{osId}}", "rejeitar"] }
          }
        },
        {
          "name": "4 - Notificar Conclusão",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/ordens-servico/{{osId}}/notificar-conclusao", "host": ["{{baseUrl}}"], "path": ["api", "ordens-servico", "{{osId}}", "notificar-conclusao"] }
          }
        },
        {
          "name": "5 - Entregar Veículo",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/ordens-servico/{{osId}}/entregar", "host": ["{{baseUrl}}"], "path": ["api", "ordens-servico", "{{osId}}", "entregar"] }
          }
        },
        {
          "name": "Histórico de Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/ordens-servico/{{osId}}/historico", "host": ["{{baseUrl}}"], "path": ["api", "ordens-servico", "{{osId}}", "historico"] }
          }
        }
      ]
